# Env overlay template. Together with .env.defaults this is the only
# env documentation — do not duplicate key lists in README or docs.
# Copy, fill secrets, never commit the copy:
#   cp .env.example .env.local          # bash / macOS
#   Copy-Item .env.example .env.local   # Windows PowerShell
#   cp .env.example .env.production     # compose prod host (or write from CI)
#
# COMPOSE_FILE separators: Linux/macOS use ":"; Windows Docker Compose
# needs ";". .env.defaults uses ":". Override in .env.local on Windows:
# COMPOSE_FILE=docker-compose.yml;docker-compose.infra.yml;docker-compose.langfuse.yml;docker-compose.monitoring.yml;docker-compose.logging.yml;docker-compose.override.yml
#
# Load: docker compose --env-file .env.defaults --env-file .env.local ...
# Later files override .env.defaults. Empty values here would wipe defaults —
# leave a key unset (commented) unless you mean to override it.

# --- Secrets (required for a real bot) ---
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
API_INTERNAL_TOKEN=
REQUIRED_USER_TELEGRAM_ID=
# Other accounts of the owner, comma-separated ids
OWNER_EXTRA_TELEGRAM_IDS=

# Optional integrations
WEB_SEARCH_API_KEY=
# Same value as API_SERVER_KEY in Hermes on the PC (docs/hermes.md)
HERMES_API_KEY=
# Largest generated HTML report sent as a document (bytes); default in .env.defaults
# HERMES_FILE_MAX_BYTES=262144
ELEVENLABS_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ID_SALT=

# Claude only if LLM_PROVIDER=claude (not needed for DeepSeek)
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Override local DB/Redis passwords in production:
# POSTGRES_PASSWORD=
# REDIS_AUTH=
# BROKER_REDIS_URL=redis://:YOUR_REDIS_PASS@redis:6379/0
# Broker retention (defaults in .env.defaults): handled-entry history in
# turns/tasks/outbound, reply-stream TTL, dead-consumer idle limit.
# BROKER_STREAM_RETENTION_SECONDS=86400
# BROKER_REPLY_TTL_SECONDS=300
# BROKER_CONSUMER_IDLE_SECONDS=3600

# --- Local cluster (.env.local) ---
WEB_SEARCH_ENABLED=true
LANGFUSE_ENABLED=false
WORKER_ENABLED=true
# Per-turn trace log for debugging (private chat text, stays on the server).
# Read a turn: python scripts/trace_turn.py <request_id>. Sizes in .env.defaults.
# TRACE_LOG_ENABLED=true
# Vault notes Vanessa sees on every reply, comma-separated, e.g.
# People/<card>.md. Keep private paths here, not in .env.defaults.
KNOWLEDGE_PINNED_NOTES=
# Zone for scheduled posts (cron and "tomorrow at 10"); default in .env.defaults
# SCHEDULE_TIMEZONE=Asia/Tbilisi

# Hybrid Kubernetes: drop docker-compose.logging.yml from COMPOSE_FILE
# (one Loki — cluster stack + hostPort 3100). Then:
# LOKI_URL=http://kubernetes.docker.internal:3100
# PROMETHEUS_CONFIG=prometheus/prometheus.k8s.yml
# GRAFANA_ADMIN_PASSWORD=  # set in production; UIs bind 127.0.0.1

# --- Production (.env.production) — uncomment and copy into that file ---
# Linux/macOS:
# COMPOSE_FILE=docker-compose.yml:docker-compose.infra.yml:docker-compose.langfuse.yml:docker-compose.monitoring.yml:docker-compose.logging.yml:docker-compose.prod.yml
# Windows Compose:
# COMPOSE_FILE=docker-compose.yml;docker-compose.infra.yml;docker-compose.langfuse.yml;docker-compose.monitoring.yml;docker-compose.logging.yml;docker-compose.prod.yml
# WORKER_ENABLED=true
# METRICS_REQUIRE_TOKEN=true
# LANGFUSE_ENABLED=false
# WEB_SEARCH_ENABLED=false

# --- Presence (game PC, not compose) ---
# BROKER_REDIS_URL must reach Redis from that machine (not container 127.0.0.1).
# PRESENCE_AVATAR_PATH=C:\path\to\avatar.yaml
# Copy config/presence/avatar.yaml if OSC parameter names differ.
