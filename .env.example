# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
REQUIRED_USER_TELEGRAM_ID=123456789
# Single-chat mode: set to a chat ID (e.g. -1001234567890) to make the bot work
# only in that one chat. Leave 0 to allow any chat where the owner is present.
ALLOWED_CHAT_TELEGRAM_ID=0

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vanessa
POSTGRES_PASSWORD=vanessa
POSTGRES_DB=vanessa

# Qdrant
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=messages
# Dedicated collection for the semantic knowledge vault notes (People/Lore/
# Culture/Logs) — the primary embedding search source; raw messages stay in
# QDRANT_COLLECTION as a fallback.
QDRANT_KNOWLEDGE_COLLECTION=knowledge

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# LLM provider: deepseek (default) or claude
LLM_PROVIDER=deepseek

# DeepSeek (generation, OpenAI-compatible API)
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4096

# Anthropic Claude (alternative; only needed if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=4096

# Humor Critic (Generator–Critic pattern, on humor turns by default)
CRITIC_ENABLED=false
CRITIC_MAX_ITERATIONS=1
CRITIC_MODEL=
CRITIC_APPLY_TO_ALL=false

# RAG
RAG_CONTEXT_MIN=20
RAG_CONTEXT_MAX=50
RAG_HYBRID_TOP_K=20
RAG_EMBED_CACHE_SIZE=256
RAG_EMBED_MAX_CHARS=2000
RAG_ANCHOR_MAX=10
RAG_CONTEXT_WINDOW_BEFORE=10
RAG_CONTEXT_WINDOW_AFTER=10
RAG_CONTEXT_WINDOW_MAX_TOTAL=220
RAG_QUERY_REWRITE_USE_LLM=true
RAG_VECTOR_MIN_SCORE=0.35

# Semantic vector search over the knowledge vault
KNOWLEDGE_VECTOR_TOP_K=10
KNOWLEDGE_VECTOR_MIN_SCORE=0.3
# Participants digest injected into the query-composition prompt
KNOWLEDGE_PARTICIPANT_MAX_PEOPLE=20
KNOWLEDGE_PARTICIPANT_MAX_FACTS=5

# Qdrant memory tuning (~200k vectors)
QDRANT_ON_DISK=true
QDRANT_QUANTIZATION_ENABLED=true
QDRANT_INDEXING_THRESHOLD=20000
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=64

# PostgreSQL pool (API process)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2

# Decision engine (session tuning → config/content.yaml conversation section)
DECISION_RELEVANCE_THRESHOLD=0.76
DECISION_RATE_LIMIT_PER_MINUTE=10
DECISION_BOT_NAMES=
DECISION_TRIGGER_KEYWORDS=
DECISION_PLANNER_PREFILTER=true

# Content (directory with one YAML per section: bot, persona, conversation,
# llm, decision, memory, rag, profanity)
CONTENT_CONFIG_PATH=config/content

# History import: poetry run python scripts/import_telegram_history.py --export ...

# API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://api:8000
API_INTERNAL_TOKEN=
API_AUTO_CREATE_SCHEMA=false
INDEXING_MAX_RETRIES=2
LLM_MAX_RETRIES=2

# Logging
LOG_LEVEL=INFO
# Persist logs to disk with rotation (one file per service: api.log / bot.log / ...)
LOG_DIR=logs
LOG_FILE_ENABLED=true
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=5
# Optional file log level; empty means same as LOG_LEVEL
LOG_FILE_LEVEL=

# Obsidian vault sync (/note in owner DM)
# Host path to a cloned private vault repo (mounted at /vault in bot)
OBSIDIAN_VAULT_HOST_PATH=./data/obsidian-vault
OBSIDIAN_VAULT_PATH=/vault
OBSIDIAN_NOTES_SUBDIR=telegram
OBSIDIAN_ATTACHMENTS_SUBDIR=attachments
OBSIDIAN_GIT_ENABLED=true
OBSIDIAN_GIT_REMOTE=origin
OBSIDIAN_GIT_BRANCH=
OBSIDIAN_GIT_USER_NAME=VanessaAI Bot
OBSIDIAN_GIT_USER_EMAIL=bot@vanessa.local
# Dir with id_ed25519 + known_hosts for git push over SSH
OBSIDIAN_SSH_DIR=./.ssh/obsidian

# Knowledge vault — Vanessa's own structured memory (repo-local ./knowledge)
KNOWLEDGE_PATH=knowledge
# Read path: max knowledge blocks injected into a reply
KNOWLEDGE_MAX_BLOCKS=3
KNOWLEDGE_PEOPLE_MAX_BLOCKS=1
# Write path: post-reply extraction (at the end of each reply)
KNOWLEDGE_MEMORY_ENABLED=true
KNOWLEDGE_MEMORY_COOLDOWN_SECONDS=300
KNOWLEDGE_MEMORY_MAX_TOKENS=512
KNOWLEDGE_MODEL=
# Write path: periodic sweep every N messages (chunked to fit context window)
KNOWLEDGE_SWEEP_ENABLED=true
KNOWLEDGE_SWEEP_INTERVAL_MESSAGES=50
KNOWLEDGE_SWEEP_BATCH_SIZE=200
KNOWLEDGE_SWEEP_WINDOW_SIZE=40
KNOWLEDGE_SWEEP_WINDOW_OVERLAP=10
KNOWLEDGE_SWEEP_POLL_SECONDS=60

# Mood & relationship metrics (knowledge vault) — per-participant profiles
KNOWLEDGE_METRICS_ENABLED=true
KNOWLEDGE_METRICS_MODEL=
KNOWLEDGE_METRICS_MAX_TOKENS=768
KNOWLEDGE_METRICS_COOLDOWN_SECONDS=900
KNOWLEDGE_METRICS_HISTORY_DAYS=14
# Behavioral feedback from metrics (decision gate + compose tone)
DECISION_METRICS_RULE_ENABLED=true
DECISION_TOXICITY_IGNORE_THRESHOLD=0.8
DECISION_TRUST_IGNORE_THRESHOLD=30.0
FEEDBACK_TONE_ENABLED=true
