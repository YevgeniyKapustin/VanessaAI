# Overlay template. Copy, fill secrets, never commit the copy:
#   cp .env.example .env.local          # laptop / docker compose cluster
#   cp .env.example .env.production     # compose prod host (or write from CI)
#
# Load: docker compose --env-file .env.defaults --env-file .env.local ...
# Later files override .env.defaults. Empty values here would wipe defaults —
# leave a key unset (commented) unless you mean to override it.

# --- Secrets (required for a real bot) ---
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
API_INTERNAL_TOKEN=
HF_TOKEN=
REQUIRED_USER_TELEGRAM_ID=

# Optional integrations
WEB_SEARCH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ID_SALT=

# Claude only if LLM_PROVIDER=claude (not needed for DeepSeek)
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Override local DB/Redis passwords in production:
# POSTGRES_PASSWORD=
# REDIS_AUTH=
# BROKER_REDIS_URL=redis://:YOUR_REDIS_PASS@redis:6379/0

# --- Local cluster (.env.local) ---
WEB_SEARCH_ENABLED=true
LANGFUSE_ENABLED=false
TRANSPORT=http
WORKER_ENABLED=false

# --- Production (.env.production) — uncomment and copy into that file ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.infra.yml:docker-compose.langfuse.yml:docker-compose.monitoring.yml:docker-compose.prod.yml
# TRANSPORT=redis
# WORKER_ENABLED=true
# METRICS_REQUIRE_TOKEN=true
# LANGFUSE_ENABLED=false
# WEB_SEARCH_ENABLED=false
