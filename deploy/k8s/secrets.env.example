# Vanessa K8s secrets catalog. Values live in the project .env — never commit them.
# Apply with: poetry run python scripts/k8s_secrets.py apply
# Do not kubectl-apply this file; it has no values.

# --- always required ---
BROKER_REDIS_URL=
POSTGRES_PASSWORD=
TELEGRAM_BOT_TOKEN=

# --- required when LLM_PROVIDER=deepseek (default) ---
DEEPSEEK_API_KEY=

# --- required when LLM_PROVIDER=claude ---
ANTHROPIC_API_KEY=

# --- required when WEB_SEARCH_ENABLED=true (unless provider=duckduckgo) ---
WEB_SEARCH_API_KEY=

# --- optional ---
API_INTERNAL_TOKEN=
HF_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ID_SALT=
OBSIDIAN_GIT_REMOTE=
