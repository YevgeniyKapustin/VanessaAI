{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "title": "Vanessa — Broker & Worker",
  "uid": "vanessa-broker",
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["vanessa"],
  "panels": [
    {
      "id": 1,
      "title": "Broker publish rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (stream) (rate(vanessa_broker_published_total[5m]))",
          "legendFormat": "{{stream}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Broker consume rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "sum by (stream) (rate(vanessa_broker_consumed_total[5m]))",
          "legendFormat": "{{stream}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "DLQ growth",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum by (stream) (increase(vanessa_broker_dlq_total[5m]))",
          "legendFormat": "{{stream}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Stream length & DLQ depth",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "vanessa_broker_stream_length",
          "legendFormat": "len {{stream}}",
          "refId": "A"
        },
        {
          "expr": "vanessa_broker_dlq_depth",
          "legendFormat": "dlq {{stream}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Consumer lag (pending)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "vanessa_broker_consumer_lag",
          "legendFormat": "{{stream}}/{{group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "MCP RPC latency p95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(vanessa_broker_rpc_duration_seconds_bucket[5m])))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    }
  ]
}
